<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSMicrophoneUsageDescription</key>
    <string>Insapp-meet записывает звук с микрофона для расшифровки встреч.</string>
    <key>NSScreenCaptureUsageDescription</key>
    <string>Insapp-meet записывает системный звук с экрана чтобы захватить голоса других участников встречи.</string>
    <key>NSAudioCaptureUsageDescription</key>
    <string>Insapp-meet записывает звук системы для расшифровки встреч.</string>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Не сохранять/восстанавливать окна при выходе: второй слой защиты от цикла
         краш -> восстановление окон -> краш (основной слой - очистка saved-state в run()). -->
    <key>NSQuitAlwaysKeepsWindows</key>
    <false/>
</dict>
</plist>
